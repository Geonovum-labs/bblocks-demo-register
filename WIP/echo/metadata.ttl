@prefix apkg: <http://w3id.org/apkg/terms#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://processes.staging.roofer-online.nl/ogcapi/processes/echo#> .

ex:echo a apkg:ApplicationPackage ;
    dct:identifier "https://processes.staging.roofer-online.nl/ogcapi/processes/echo" ;
    dct:title "Echo" ;
    dct:description "Return the supplied value as a process output." ;
    dct:issued "2025-12-17"^^xsd:date ;
    dct:modified "2025-12-17"^^xsd:date .
    
ex:echoProcess a apkg:Process ;
    dct:type "CommandLineTool" ;
    apkg:hasInput ex:echoValue ;
    apkg:hasOutput ex:echoValue .

ex:echoValue a apkg:Parameter ;
    dct:identifier "value" ;
    dct:type "string" ;
    apkg:label "value" .

