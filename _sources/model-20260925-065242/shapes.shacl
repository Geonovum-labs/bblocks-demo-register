@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

dct:Frequency a rdfs:Class .

dct:LicenseDocument a rdfs:Class .

dct:LinguisticSystem a rdfs:Class .

dct:Location a rdfs:Class .

dct:MediaType a rdfs:Class .

dct:MediaTypeOrExtent a rdfs:Class .

dct:PeriodOfTime a rdfs:Class .

dct:ProvenanceStatement a rdfs:Class .

dct:RightsStatement a rdfs:Class .

dct:Standard a rdfs:Class .

<http://data.europa.eu/eli/ontology#LegalResource> a rdfs:Class .

<http://spdx.org/rdf/terms#Checksum> a rdfs:Class .

<http://spdx.org/rdf/terms#ChecksumAlgorithm> a rdfs:Class .

<http://www.w3.org/2004/02/skos/core#Concept> a rdfs:Class .

<http://www.w3.org/2004/02/skos/core#ConceptScheme> a rdfs:Class .

<http://www.w3.org/2006/time#Instant> a rdfs:Class .

<http://www.w3.org/2006/vcard/ns#Kind> a rdfs:Class .

<http://www.w3.org/ns/adms#Identifier> a rdfs:Class .

<http://www.w3.org/ns/dcat#Catalog> a rdfs:Class .

<http://www.w3.org/ns/dcat#CatalogRecord> a rdfs:Class .

<http://www.w3.org/ns/dcat#DataService> a rdfs:Class .

<http://www.w3.org/ns/dcat#Dataset> a rdfs:Class .

<http://www.w3.org/ns/dcat#DatasetSeries> a rdfs:Class .

<http://www.w3.org/ns/dcat#Distribution> a rdfs:Class .

<http://www.w3.org/ns/dcat#Relationship> a rdfs:Class .

<http://www.w3.org/ns/dcat#Resource> a rdfs:Class .

<http://www.w3.org/ns/dcat#Role> a rdfs:Class .

<http://www.w3.org/ns/locn#Geometry> a rdfs:Class .

<http://www.w3.org/ns/odrl/2/Policy> a rdfs:Class .

<http://www.w3.org/ns/prov#Activity> a rdfs:Class .

<http://www.w3.org/ns/prov#Attribution> a rdfs:Class .

<http://xmlns.com/foaf/0.1/Agent> a rdfs:Class .

<http://xmlns.com/foaf/0.1/Document> a rdfs:Class .

rdfs:Literal a rdfs:Class .

rdfs:Resource a rdfs:Class .

dct:accessRights a rdf:Property .

dct:accrualPeriodicity a rdf:Property .

dct:conformsTo a rdf:Property .

dct:creator a rdf:Property .

dct:description a rdf:Property .

dct:format a rdf:Property .

dct:hasPart a rdf:Property .

dct:identifier a rdf:Property .

dct:isReferencedBy a rdf:Property .

dct:issued a rdf:Property .

dct:language a rdf:Property .

dct:license a rdf:Property .

dct:modified a rdf:Property .

dct:provenance a rdf:Property .

dct:publisher a rdf:Property .

dct:relation a rdf:Property .

dct:rights a rdf:Property .

dct:source a rdf:Property .

dct:spatial a rdf:Property .

dct:temporal a rdf:Property .

dct:title a rdf:Property .

dct:type a rdf:Property .

<http://data.europa.eu/r5r/applicableLegislation> a rdf:Property .

<http://data.europa.eu/r5r/availability> a rdf:Property .

<http://data.europa.eu/r5r/hvdCategory> a rdf:Property .

<http://spdx.org/rdf/terms#algorithm> a rdf:Property .

<http://spdx.org/rdf/terms#checksum> a rdf:Property .

<http://spdx.org/rdf/terms#checksumValue> a rdf:Property .

<http://www.w3.org/2004/02/skos/core#notation> a rdf:Property .

<http://www.w3.org/2006/time#hasBeginning> a rdf:Property .

<http://www.w3.org/2006/time#hasEnd> a rdf:Property .

<http://www.w3.org/ns/adms#identifier> a rdf:Property .

<http://www.w3.org/ns/adms#sample> a rdf:Property .

<http://www.w3.org/ns/adms#status> a rdf:Property .

<http://www.w3.org/ns/dcat#accessService> a rdf:Property .

<http://www.w3.org/ns/dcat#accessURL> a rdf:Property .

<http://www.w3.org/ns/dcat#bbox> a rdf:Property .

<http://www.w3.org/ns/dcat#byteSize> a rdf:Property .

<http://www.w3.org/ns/dcat#catalog> a rdf:Property .

<http://www.w3.org/ns/dcat#centroid> a rdf:Property .

<http://www.w3.org/ns/dcat#compressFormat> a rdf:Property .

<http://www.w3.org/ns/dcat#contactPoint> a rdf:Property .

<http://www.w3.org/ns/dcat#dataset> a rdf:Property .

<http://www.w3.org/ns/dcat#distribution> a rdf:Property .

<http://www.w3.org/ns/dcat#downloadURL> a rdf:Property .

<http://www.w3.org/ns/dcat#endDate> a rdf:Property .

<http://www.w3.org/ns/dcat#endpointDescription> a rdf:Property .

<http://www.w3.org/ns/dcat#endpointURL> a rdf:Property .

<http://www.w3.org/ns/dcat#hadRole> a rdf:Property .

<http://www.w3.org/ns/dcat#hasVersion> a rdf:Property .

<http://www.w3.org/ns/dcat#inSeries> a rdf:Property .

<http://www.w3.org/ns/dcat#keyword> a rdf:Property .

<http://www.w3.org/ns/dcat#landingPage> a rdf:Property .

<http://www.w3.org/ns/dcat#mediaType> a rdf:Property .

<http://www.w3.org/ns/dcat#packageFormat> a rdf:Property .

<http://www.w3.org/ns/dcat#qualifiedRelation> a rdf:Property .

<http://www.w3.org/ns/dcat#record> a rdf:Property .

<http://www.w3.org/ns/dcat#servesDataset> a rdf:Property .

<http://www.w3.org/ns/dcat#service> a rdf:Property .

<http://www.w3.org/ns/dcat#spatialResolutionInMeters> a rdf:Property .

<http://www.w3.org/ns/dcat#startDate> a rdf:Property .

<http://www.w3.org/ns/dcat#temporalResolution> a rdf:Property .

<http://www.w3.org/ns/dcat#theme> a rdf:Property .

<http://www.w3.org/ns/dcat#themeTaxonomy> a rdf:Property .

<http://www.w3.org/ns/dcat#version> a rdf:Property .

<http://www.w3.org/ns/locn#geometry> a rdf:Property .

<http://www.w3.org/ns/odrl/2/hasPolicy> a rdf:Property .

<http://www.w3.org/ns/prov#qualifiedAttribution> a rdf:Property .

<http://www.w3.org/ns/prov#wasGeneratedBy> a rdf:Property .

<http://xmlns.com/foaf/0.1/homepage> a rdf:Property .

<http://xmlns.com/foaf/0.1/page> a rdf:Property .

<http://xmlns.com/foaf/0.1/primaryTopic> a rdf:Property .

xsd:date a rdfs:Datatype .

xsd:dateTime a rdfs:Datatype .

xsd:decimal a rdfs:Datatype .

xsd:duration a rdfs:Datatype .

xsd:gYear a rdfs:Datatype .

xsd:gYearMonth a rdfs:Datatype .

xsd:hexBinary a rdfs:Datatype .

xsd:nonNegativeInteger a rdfs:Datatype .

[
  a sh:NodeShape ;
  sh:name "ProvenanceStatement" ;
  sh:targetClass dct:ProvenanceStatement ;
] .

[
  a sh:NodeShape ;
  sh:name "LegalResource" ;
  sh:targetClass <http://data.europa.eu/eli/ontology#LegalResource> ;
] .

[
  a sh:NodeShape ;
  sh:name "TimeInstant" ;
  sh:targetClass <http://www.w3.org/2006/time#Instant> ;
] .

[
  a sh:NodeShape ;
  sh:name "LicenseDocument" ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/2004/02/skos/core#Concept> ;
    sh:description "A type of licence, e.g. indicating 'public domain' or 'royalties required'."@en ;
    sh:name "type"@en ;
    sh:path dct:type ;
  ] ;
  sh:targetClass dct:LicenseDocument ;
] .

[
  a sh:NodeShape ;
  sh:name "ChecksumAlgorithm" ;
  sh:targetClass <http://spdx.org/rdf/terms#ChecksumAlgorithm> ;
] .

[
  a sh:NodeShape ;
  sh:name "Relationship" ;
  sh:property [
    a sh:PropertyShape ;
    sh:description "A resource related to the source resource."@en ;
    sh:minCount 1 ;
    sh:name "relation"@en ;
    sh:path dct:relation ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/ns/dcat#Role> ;
    sh:description "A function of an entity or agent with respect to another entity or resource."@en ;
    sh:minCount 1 ;
    sh:name "had role"@en ;
    sh:path <http://www.w3.org/ns/dcat#hadRole> ;
  ] ;
  sh:targetClass <http://www.w3.org/ns/dcat#Relationship> ;
] .

[
  a sh:NodeShape ;
  sh:name "Policy" ;
  sh:targetClass <http://www.w3.org/ns/odrl/2/Policy> ;
] .

[
  a sh:NodeShape ;
  sh:name "Agent" ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/2004/02/skos/core#Concept> ;
    sh:description "The nature of the agent."@en ;
    sh:maxCount 1 ;
    sh:name "type"@en ;
    sh:path dct:type ;
  ] ;
  sh:targetClass <http://xmlns.com/foaf/0.1/Agent> ;
] .

[
  a sh:NodeShape ;
  sh:name "Resource" ;
  sh:targetClass <http://www.w3.org/ns/dcat#Resource> ;
] .

[
  a sh:NodeShape ;
  sh:name "Role" ;
  sh:targetClass <http://www.w3.org/ns/dcat#Role> ;
] .

[
  a sh:NodeShape ;
  sh:name "Geometry" ;
  sh:targetClass <http://www.w3.org/ns/locn#Geometry> ;
] .

[
  a sh:NodeShape ;
  sh:name "Data Service"@en ;
  sh:name "Data Service"@nl ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://xmlns.com/foaf/0.1/Agent> ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "creator"@en ;
    sh:name "vervaardiger"@nl ;
    sh:path dct:creator ;
    sh:severity sh:Warning ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class dct:LinguisticSystem ;
    sh:minCount 1 ;
    sh:name "language"@en ;
    sh:name "taal"@nl ;
    sh:path dct:language ;
    sh:severity sh:Warning ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class rdfs:Resource ;
    sh:description "The root location or primary endpoint of the service (an IRI)."@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "endpoint URL"@en ;
    sh:name "endpoint-URL"@nl ;
    sh:path <http://www.w3.org/ns/dcat#endpointURL> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class dct:RightsStatement ;
    sh:description "A statement that specifies rights associated with the Data Service."@en ;
    sh:name "rechten"@nl ;
    sh:name "rights"@en ;
    sh:path dct:rights ;
    sh:severity sh:Info ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class dct:MediaTypeOrExtent ;
    sh:description "The structure that can be returned by querying the endpointURL."@en ;
    sh:name "formaat"@nl ;
    sh:name "format"@en ;
    sh:path dct:format ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://xmlns.com/foaf/0.1/Agent> ;
    sh:description "An entity (organisation) responsible for making the Data Service available."@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "publisher"@en ;
    sh:name "uitgever"@nl ;
    sh:path dct:publisher ;
    sh:severity sh:Violation ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/ns/dcat#Dataset> ;
    sh:description "This property refers to a collection of data that this data service can distribute."@en ;
    sh:name "bedient dataset"@nl ;
    sh:name "serves dataset"@en ;
    sh:path <http://www.w3.org/ns/dcat#servesDataset> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/2004/02/skos/core#Concept> ;
    sh:description "The HVD category to which this Data Service belongs."@en ;
    sh:name "HVD Category"@en ;
    sh:name "HVD-categorie"@nl ;
    sh:path <http://data.europa.eu/r5r/hvdCategory> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/2006/vcard/ns#Kind> ;
    sh:description "Contact information that can be used for sending comments about the Data Service."@en ;
    sh:minCount 1 ;
    sh:name "contact point"@en ;
    sh:name "contactpunt"@nl ;
    sh:path <http://www.w3.org/ns/dcat#contactPoint> ;
    sh:severity sh:Violation ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:name "gewijzigd"@nl ;
    sh:name "modification date"@en ;
    sh:path dct:modified ;
    sh:severity sh:Info ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:description "A name given to the Data Service."@en ;
    sh:minCount 1 ;
    sh:name "titel"@nl ;
    sh:name "title"@en ;
    sh:path dct:title ;
    sh:severity sh:Violation ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://xmlns.com/foaf/0.1/Document> ;
    sh:description "A page or document about this Data Service"@en ;
    sh:name "documentatie"@nl ;
    sh:name "documentation"@en ;
    sh:path <http://xmlns.com/foaf/0.1/page> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://xmlns.com/foaf/0.1/Document> ;
    sh:description "A web page that provides access to the Data Service and/or additional information."@en ;
    sh:name "landing page"@en ;
    sh:name "landingspagina"@nl ;
    sh:path <http://www.w3.org/ns/dcat#landingPage> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://data.europa.eu/eli/ontology#LegalResource> ;
    sh:description "The legislation that mandates the creation or management of the Data Service."@en ;
    sh:name "applicable legislation"@en ;
    sh:name "toepasbare wetgeving"@nl ;
    sh:path <http://data.europa.eu/r5r/applicableLegislation> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class rdfs:Resource ;
    sh:description "A description of the services available via the end-points, including their operations, parameters etc."@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "endpoint description"@en ;
    sh:name "endpointbeschrijving"@nl ;
    sh:path <http://www.w3.org/ns/dcat#endpointDescription> ;
    sh:severity sh:Violation ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class dct:Standard ;
    sh:description "An established (technical) standard to which the Data Service conforms."@en ;
    sh:name "conforms to"@en ;
    sh:name "voldoet aan"@nl ;
    sh:path dct:conformsTo ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class dct:LicenseDocument ;
    sh:description "A licence under which the Data service is made available."@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "licence"@en ;
    sh:name "licentie"@nl ;
    sh:path dct:license ;
    sh:severity sh:Violation ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/ns/adms#Identifier> ;
    sh:name "other identifier"@en ;
    sh:name "overige identificator"@nl ;
    sh:path <http://www.w3.org/ns/adms#identifier> ;
    sh:severity sh:Info ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/2004/02/skos/core#Concept> ;
    sh:description "A category of the Data Service."@en ;
    sh:minCount 1 ;
    sh:name "thema"@nl ;
    sh:name "theme"@en ;
    sh:path <http://www.w3.org/ns/dcat#theme> ;
    sh:severity sh:Violation ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:description "A keyword or tag describing the Data Service."@en ;
    sh:minCount 1 ;
    sh:name "keyword"@en ;
    sh:name "trefwoord"@nl ;
    sh:path <http://www.w3.org/ns/dcat#keyword> ;
    sh:severity sh:Warning ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "identificator"@nl ;
    sh:name "identifier"@en ;
    sh:path dct:identifier ;
    sh:severity sh:Violation ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class dct:RightsStatement ;
    sh:description "Information regarding access or restrictions based on privacy, security, or other policies."@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "access rights"@en ;
    sh:name "toegangsrechten"@nl ;
    sh:path dct:accessRights ;
    sh:severity sh:Violation ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:description "A free-text account of the Data Service."@en ;
    sh:minCount 1 ;
    sh:name "beschrijving"@nl ;
    sh:name "description"@en ;
    sh:path dct:description ;
    sh:severity sh:Violation ;
  ] ;
  sh:targetClass <http://www.w3.org/ns/dcat#DataService> ;
] .

[
  a sh:NodeShape ;
  sh:name "LinguisticSystem" ;
  sh:targetClass dct:LinguisticSystem ;
] .

[
  a sh:NodeShape ;
  sh:name "Distributie"@nl ;
  sh:name "Distribution"@en ;
  sh:property [
    a sh:PropertyShape ;
    sh:class dct:MediaType ;
    sh:description "The media type of the Distribution as defined in the official register of media types managed by IANA."@en ;
    sh:maxCount 1 ;
    sh:name "media type"@en ;
    sh:name "mediatype"@nl ;
    sh:path <http://www.w3.org/ns/dcat#mediaType> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://data.europa.eu/eli/ontology#LegalResource> ;
    sh:description "The legislation that mandates the creation or management of the Distribution."@en ;
    sh:name "applicable legislation"@en ;
    sh:name "toepasbare wetgeving"@nl ;
    sh:path <http://data.europa.eu/r5r/applicableLegislation> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class dct:LinguisticSystem ;
    sh:description "A language used in the Distribution."@en ;
    sh:minCount 1 ;
    sh:name "language"@en ;
    sh:name "taal"@nl ;
    sh:path dct:language ;
    sh:severity sh:Warning ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:datatype xsd:decimal ;
    sh:description "The minimum spatial separation resolvable in a dataset distribution, measured in meters."@en ;
    sh:maxCount 1 ;
    sh:name "ruimtelijke resolutie in meters"@nl ;
    sh:name "spatial resolution"@en ;
    sh:path <http://www.w3.org/ns/dcat#spatialResolutionInMeters> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:description "A name given to the Distribution."@en ;
    sh:name "titel"@nl ;
    sh:name "title"@en ;
    sh:path dct:title ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/ns/odrl/2/Policy> ;
    sh:description "The policy expressing the rights associated with the distribution if using the [[ODRL]] vocabulary."@en ;
    sh:maxCount 1 ;
    sh:name "has policy"@en ;
    sh:name "heeft beleid"@nl ;
    sh:path <http://www.w3.org/ns/odrl/2/hasPolicy> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/2004/02/skos/core#Concept> ;
    sh:description "An indication how long it is planned to keep the Distribution of the Dataset available."@en ;
    sh:maxCount 1 ;
    sh:name "availability"@en ;
    sh:name "beschikbaarheid"@nl ;
    sh:path <http://data.europa.eu/r5r/availability> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class dct:MediaType ;
    sh:description "The format of the file in which the data is contained in a compressed form, e.g. to reduce the size of the downloadable file."@en ;
    sh:maxCount 1 ;
    sh:name "compressieformaat"@nl ;
    sh:name "compression format"@en ;
    sh:path <http://www.w3.org/ns/dcat#compressFormat> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class dct:RightsStatement ;
    sh:description "A statement that specifies rights associated with the Distribution."@en ;
    sh:name "rechten"@nl ;
    sh:name "rights"@en ;
    sh:path dct:rights ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class dct:MediaType ;
    sh:description "The format of the file in which one or more data files are grouped together, e.g. to enable a set of related files to be downloaded together."@en ;
    sh:maxCount 1 ;
    sh:name "packaging format"@en ;
    sh:name "pakketformaat"@nl ;
    sh:path <http://www.w3.org/ns/dcat#packageFormat> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class dct:LicenseDocument ;
    sh:description "A licence under which the Distribution is made available."@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "licence"@en ;
    sh:name "licentie"@nl ;
    sh:path dct:license ;
    sh:severity sh:Violation ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:datatype xsd:nonNegativeInteger ;
    sh:description "The size of a Distribution in bytes."@en ;
    sh:maxCount 1 ;
    sh:name "byte size"@en ;
    sh:name "bytesize"@nl ;
    sh:path <http://www.w3.org/ns/dcat#byteSize> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:description "A URL that gives access to a Distribution of the Dataset."@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "access URL"@en ;
    sh:name "toegangs-URL"@nl ;
    sh:path <http://www.w3.org/ns/dcat#accessURL> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:description "The most recent date on which the Distribution was changed or modified."@en ;
    sh:maxCount 1 ;
    sh:name "gewijzigd"@nl ;
    sh:name "modified"@en ;
    sh:path dct:modified ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:description "A free-text account of the Distribution."@en ;
    sh:name "beschrijving"@nl ;
    sh:name "description"@en ;
    sh:path dct:description ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:datatype xsd:duration ;
    sh:description "The minimum time period resolvable in the dataset distribution."@en ;
    sh:maxCount 1 ;
    sh:name "temporal resolution"@en ;
    sh:name "tijdresolutie"@nl ;
