[
  a sh:NodeShape ;
  sh:name "Identifier" ;
  sh:property [
    a sh:PropertyShape ;
    sh:description "A string that is an identifier in the context of the identifier scheme referenced by its datatype."@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "notation"@en ;
    sh:path <http://www.w3.org/2004/02/skos/core#notation> ;
  ] ;
  sh:targetClass <http://www.w3.org/ns/adms#Identifier> ;
] .

[
  a sh:NodeShape ;
  sh:name "Activity" ;
  sh:targetClass <http://www.w3.org/ns/prov#Activity> ;
] .

[
  a sh:NodeShape ;
  sh:name "Standard" ;
  sh:targetClass dct:Standard ;
] .

[
  a sh:NodeShape ;
  sh:name "Kind" ;
  sh:targetClass <http://www.w3.org/2006/vcard/ns#Kind> ;
] .

[
  a sh:NodeShape ;
  sh:name "TemporalLiteral" ;
  sh:targetClass rdfs:Literal ;
] .

[
  a sh:NodeShape ;
  sh:name "Catalog"@en ;
  sh:name "Catalogus"@nl ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
    sh:description "A knowledge organization system used to classify the Resources that are in the Catalogue."@en ;
    sh:name "thema taxonomie"@nl ;
    sh:name "theme taxonomy"@en ;
    sh:path <http://www.w3.org/ns/dcat#themeTaxonomy> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://xmlns.com/foaf/0.1/Agent> ;
    sh:description "An entity responsible for the creation of the catalogue."@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "creator"@en ;
    sh:name "vervaardiger"@nl ;
    sh:path dct:creator ;
    sh:severity sh:Warning ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://data.europa.eu/eli/ontology#LegalResource> ;
    sh:description "The legislation that mandates the creation or management of the Catalogue."@en ;
    sh:name "applicable legislation"@en ;
    sh:name "toepasbare wetgeving"@nl ;
    sh:path <http://data.europa.eu/r5r/applicableLegislation> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:description "A name given to the Catalogue."@en ;
    sh:minCount 1 ;
    sh:name "titel"@nl ;
    sh:name "title"@en ;
    sh:path dct:title ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class dct:PeriodOfTime ;
    sh:description "A temporal period that the Catalogue covers."@en ;
    sh:name "temporal"@en ;
    sh:name "tijddekking"@nl ;
    sh:path dct:temporal ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/ns/dcat#CatalogRecord> ;
    sh:description "A Catalogue Record that is part of the Catalogue."@en ;
    sh:name "record"@en ;
    sh:name "record"@nl ;
    sh:path <http://www.w3.org/ns/dcat#record> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/ns/dcat#Catalog> ;
    sh:description "A catalogue whose contents are of interest in the context of this catalogue."@en ;
    sh:name "catalog"@en ;
    sh:name "catalogus"@nl ;
    sh:path <http://www.w3.org/ns/dcat#catalog> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:description "A free-text account of the Catalogue."@en ;
    sh:minCount 1 ;
    sh:name "beschrijving"@nl ;
    sh:name "description"@en ;
    sh:path dct:description ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class dct:Location ;
    sh:description "A geographical area covered by the Catalogue."@en ;
    sh:name "ruimtelijke dekking"@nl ;
    sh:name "spatial"@en ;
    sh:path dct:spatial ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://xmlns.com/foaf/0.1/Document> ;
    sh:description "A web page that acts as the main page for the Catalogue."@en ;
    sh:maxCount 1 ;
    sh:name "homepage"@en ;
    sh:name "homepage"@nl ;
    sh:path <http://xmlns.com/foaf/0.1/homepage> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/ns/dcat#Dataset> ;
    sh:description "A Dataset that is part of the Catalogue."@en ;
    sh:minCount 1 ;
    sh:name "dataset"@en ;
    sh:name "dataset"@nl ;
    sh:path <http://www.w3.org/ns/dcat#dataset> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:description "The most recent date on which the Catalogue was modified."@en ;
    sh:maxCount 1 ;
    sh:name "gewijzigd"@nl ;
    sh:name "modified"@en ;
    sh:path dct:modified ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/ns/dcat#Catalog> ;
    sh:description "A related Catalogue that is part of the described Catalogue."@en ;
    sh:name "has part"@en ;
    sh:name "heeft deel"@nl ;
    sh:path dct:hasPart ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class dct:LicenseDocument ;
    sh:description "A licence under which the Catalogue can be used or reused."@en ;
    sh:maxCount 1 ;
    sh:name "license"@en ;
    sh:name "licentie"@nl ;
    sh:path dct:license ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class dct:RightsStatement ;
    sh:description "A statement that specifies rights associated with the Catalogue."@en ;
    sh:name "rechten"@nl ;
    sh:name "rights"@en ;
    sh:path dct:rights ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:description "The date of formal issuance (e.g., publication) of the Catalogue."@en ;
    sh:maxCount 1 ;
    sh:name "issued"@en ;
    sh:name "uitgegeven"@nl ;
    sh:path dct:issued ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class dct:LinguisticSystem ;
    sh:description "A language used in the textual metadata describing titles, descriptions, etc. of the Datasets in the Catalogue."@en ;
    sh:name "language"@en ;
    sh:name "taal"@nl ;
    sh:path dct:language ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/ns/dcat#DataService> ;
    sh:description "A site or end-point (Data Service) that is listed in the Catalogue."@en ;
    sh:name "service"@en ;
    sh:name "service"@nl ;
    sh:path <http://www.w3.org/ns/dcat#service> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/2006/vcard/ns#Kind> ;
    sh:description "Contact information that can be used for sending comments about the Catalogue."@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "contact point"@en ;
    sh:name "contactpunt"@nl ;
    sh:path <http://www.w3.org/ns/dcat#contactPoint> ;
    sh:severity sh:Violation ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://xmlns.com/foaf/0.1/Agent> ;
    sh:description "An entity (organisation) responsible for making the Catalogue available."@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "publisher"@en ;
    sh:name "uitgever"@nl ;
    sh:path dct:publisher ;
  ] ;
  sh:targetClass <http://www.w3.org/ns/dcat#Catalog> ;
] .

[
  a sh:NodeShape ;
  sh:name "Frequency" ;
  sh:targetClass dct:Frequency ;
] .

[
  a sh:NodeShape ;
  sh:name "PeriodOfTime" ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/2006/time#Instant> ;
    sh:description "The end of a period or interval."@en ;
    sh:maxCount 1 ;
    sh:name "end"@en ;
    sh:path <http://www.w3.org/2006/time#hasEnd> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:description "The end of the period."@en ;
    sh:maxCount 1 ;
    sh:name "end date"@en ;
    sh:path <http://www.w3.org/ns/dcat#endDate> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/2006/time#Instant> ;
    sh:description "The beginning of a period or interval."@en ;
    sh:maxCount 1 ;
    sh:name "beginning"@en ;
    sh:path <http://www.w3.org/2006/time#hasBeginning> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:description "The start of the period."@en ;
    sh:maxCount 1 ;
    sh:name "start date"@en ;
    sh:path <http://www.w3.org/ns/dcat#startDate> ;
  ] ;
  sh:targetClass dct:PeriodOfTime ;
] .

[
  a sh:NodeShape ;
  sh:name "ConceptScheme" ;
  sh:property [
    a sh:PropertyShape ;
    sh:description "A name of the concept scheme."@en ;
    sh:minCount 1 ;
    sh:name "title"@en ;
    sh:path dct:title ;
  ] ;
  sh:targetClass <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
] .

[
  a sh:NodeShape ;
  sh:name "Location" ;
  sh:property [
    a sh:PropertyShape ;
    sh:description "The geographic center (centroid) of a resource."@en ;
    sh:maxCount 1 ;
    sh:name "centroid"@en ;
    sh:path <http://www.w3.org/ns/dcat#centroid> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:class <http://www.w3.org/ns/locn#Geometry> ;
    sh:description "The corresponding geometry for a resource."@en ;
    sh:maxCount 1 ;
    sh:name "geometry"@en ;
    sh:path <http://www.w3.org/ns/locn#geometry> ;
  ] ;
  sh:property [
    a sh:PropertyShape ;
    sh:description "The geographic bounding box of a resource."@en ;
    sh:maxCount 1 ;
    sh:name "bbox"@en ;
    sh:path <http://www.w3.org/ns/dcat#bbox> ;
  ] ;
  sh:targetClass dct:Location ;
] .


